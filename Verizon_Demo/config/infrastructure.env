# Ubuntu 18 infrastructure role (/home/mobility).
ROLE=infrastructure
SENDER_ID=ucla-infrastructure-nw
CLIENT_MODE=vehicle_endpoint
EXPECTED_IDENTITY=Vehicle/PassengerCar/UclaEvalDevice
REGISTRATION_REL=clients/infrastructure_vehicle/registration.json

SOURCE_PROFILE=autosense-tracking
SOURCE_TOPIC=/tracking2/tracking_objects
SOURCE_TYPE=autosense_msgs/TrackingObjectArray
SOURCE_MD5=58293c548ad89b5f0072e8120a1fdc02
SOURCE_RATE_HZ=0
SOURCE_ID=infrastructure_tracking2_2026_07_22

OBJECT_RX_TOPIC=/etx/from_vehicle/tracking_objects
JSON_RX_TOPIC=/etx/from_vehicle/json

# Attach the latest transformed detection boxes to the existing tracking JSON
# packet; this does not create a second high-rate Verizon message stream.
MARKER_SOURCE_TOPIC=/tracking2/transformed_det_box_score_label
MARKER_TYPE=visualization_msgs/MarkerArray
MARKER_MD5=d155b9ce5188fbaf89745847fd5882d7
MARKER_RX_TOPIC=

# Both Ubuntu endpoints are Vehicle clients. They publish GeoRelevance BSM;
# the Windows Software relay returns the peer payload as targeted Private TIM.
PUBLISH_TYPE=BSM
RECEIVE_TYPE=TIM
MAX_PUBLISH_RATE=12
CONTROL_HELLO_SECONDS=5

# Infrastructure NW is static. This confirmed GPS position
# (34.067086, -118.445280) is used for Verizon regional routing.
# They are not sourced from an infrastructure latitude/longitude ROS topic.
# Update both values and restart this bridge whenever the roadside unit moves.
DEFAULT_LAT=34.067086000
DEFAULT_LON=-118.445280000
LOCATION_TOPIC=
LOCATION_TYPE=gps_common/GPSFix

ORIGINAL_WS_CANDIDATES=/home/mobility/ros_ws/tracking_git_ws/devel/setup.bash:/home/mobility/ros_ws/devel/setup.bash
DEFAULT_BAG_REL=bags/infrastructure/2026-07-22-16-14-46.bag
RAW_TOPIC=/detection/lidar_detector2/objects
RAW_TYPE=autoware_msgs/DetectedObjectArray
RAW_MD5=c16aecef51c24c6808480a0295e47806
RAW_BAG_REL=bags/infrastructure/full_recording.bag
