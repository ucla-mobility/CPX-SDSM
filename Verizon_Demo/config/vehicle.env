# Ubuntu 18 vehicle role (/home/dev).
ROLE=vehicle
SENDER_ID=ucla-vehicle-01
CLIENT_MODE=vehicle_endpoint
EXPECTED_IDENTITY=Vehicle/PassengerCar/UclaEvalDevice
REGISTRATION_REL=clients/vehicle/registration.json

SOURCE_PROFILE=autosense-tracking
SOURCE_TOPIC=/tracking/tracking_objects
SOURCE_TYPE=autosense_msgs/TrackingObjectArray
SOURCE_MD5=58293c548ad89b5f0072e8120a1fdc02
SOURCE_RATE_HZ=0
SOURCE_ID=vehicle_tracking_2026_07_22

OBJECT_RX_TOPIC=/etx/from_infrastructure/tracking_objects
JSON_RX_TOPIC=/etx/from_infrastructure/json

# Reconstruct the MarkerArray attached by Infrastructure and publish it on the
# requested native Vehicle topic. No second Vehicle->ETX marker stream is made.
MARKER_SOURCE_TOPIC=
MARKER_TYPE=visualization_msgs/MarkerArray
MARKER_MD5=d155b9ce5188fbaf89745847fd5882d7
MARKER_RX_TOPIC=/tracking2/transformed_det_box_score_label

# Vehicle publishes the ACL-approved GeoRelevance/Public BSM route and receives
# the infrastructure gateway's targeted Private TIM route.
PUBLISH_TYPE=BSM
RECEIVE_TYPE=TIM
MAX_PUBLISH_RATE=12
CONTROL_HELLO_SECONDS=5

# Dynamic coordinates come from GPSFix when available. These measured UCLA
# coordinates (34°04'01.4"N, 118°26'42.9"W) are only the routing fallback
# before the first valid GPS update or when the GPS topic is unavailable.
DEFAULT_LAT=34.067055556
DEFAULT_LON=-118.445250000
LOCATION_TOPIC=/veh_2/gps/raw
LOCATION_TYPE=gps_common/GPSFix

ORIGINAL_WS_CANDIDATES=/home/dev/ros_ws/CooperFuse_Git_new/detection_tracking_ws/devel/setup.bash:/home/dev/ros_ws/tracking_git_ws/devel/setup.bash
DEFAULT_BAG_REL=bags/vehicle/2026-07-22-17-36-56.bag
RAW_TOPIC=/detection/lidar_detector/objects
RAW_TYPE=autoware_msgs/DetectedObjectArray
RAW_MD5=c16aecef51c24c6808480a0295e47806
RAW_BAG_REL=bags/vehicle/veh_full_recording_2026-07-22-17-40-10.bag
