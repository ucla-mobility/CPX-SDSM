<?xml version="1.0" encoding="UTF-8"?>
<!-- Validation variant: SimplePathlossModel alpha = 2.0 (free-space-like) vs the
     committed alpha = 2.75. Everything else identical to config.xml. -->
<root>
    <AnalogueModels>
        <AnalogueModel type="SimplePathlossModel" thresholding="true">
            <parameter name="alpha" type="double" value="2.0"/>
        </AnalogueModel>
        <AnalogueModel type="NakagamiFading">
            <parameter name="constM" type="bool" value="true"/>
            <parameter name="m" type="double" value="1.5"/>
        </AnalogueModel>
    </AnalogueModels>
    <Decider type="Decider80211p">
        <parameter name="centerFrequency" type="double" value="5.890e9"/>
    </Decider>
</root>
