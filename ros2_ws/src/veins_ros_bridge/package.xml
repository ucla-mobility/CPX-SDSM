<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>veins_ros_bridge</name>
  <version>0.1.0</version>
  <description>UDP bridge between Veins simulation and ROS 2. Uses sdsm_msgs (CPX-SDSM) as the message foundation.</description>
  <maintainer email="lab@example.edu">Lab Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sdsm_msgs</depend>
  <depend>sdsm_trust_interfaces</depend>
  <!-- exec_depend, not depend: sdsm_trust_perception already exec_depends on
       this package (its launch file starts udp_bridge_node), so a full
       <depend> here would be a real build-order cycle. udp_bridge_node.py
       imports sdsm_trust_perception.global_trust_perception.pipeline.sdsm_codec, a pure-Python
       import resolved at runtime via the sourced overlay's PYTHONPATH, not a
       build-time dependency -- exec_depend is the correct (and sufficient)
       tag. -->
  <exec_depend>sdsm_trust_perception</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
